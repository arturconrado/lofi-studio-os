# Copy to an excluded .env file; never commit credentials.
DATABASE_URL=postgresql://studio:CHANGE_ME@postgres:5432/lofi_studio
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_BUCKET=lofi-studio
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
STUDIO_ADMIN_USER=CHANGE_ME
STUDIO_ADMIN_PASSWORD=CHANGE_ME
STUDIO_MASTER_KEY=GENERATE_A_FERNET_KEY
STUDIO_PUBLIC_ORIGIN=https://lofistudiox.com
STUDIO_SIGNUP_ENABLED=0
# Replace re_xxxxxxxxx with your real Resend API key in the excluded .env file.
STUDIO_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxx
# Optional SMTP fallback: set STUDIO_EMAIL_PROVIDER=smtp and configure below.
STUDIO_SMTP_HOST=
STUDIO_SMTP_PORT=587
STUDIO_SMTP_USER=
STUDIO_SMTP_PASSWORD=
STUDIO_EMAIL_FROM=Lo-Fi Studio OS <nao-responda@lofistudiox.com>
# Disabled pending capacity and live destination validation.
LOFI_CONTINUOUS_ENABLED=0
# Configure a separate bounded worker process for each workspace.
# LOFI_WORKSPACE_ID=

STUDIO_YOUTUBE_CLIENT_ID=
STUDIO_YOUTUBE_CLIENT_SECRET=

# Off-site backup target (separate account/bucket; enable versioning + Object Lock there).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_LOCK_DAYS=0
# Real infrastructure rates; without them render cost stays "unknown", never zero.
LOFI_CPU_HOUR_USD=
LOFI_STORAGE_GB_MONTH_USD=
# Operator-reviewed provider terms, e.g. {"openrouter:google/lyria-3-pro-preview":{"url":"...","version":"...","reviewed_at":"YYYY-MM-DD"}}
LOFI_PROVIDER_TERMS_JSON=
# Set to 1 to block YouTube publication without provenance, reviewed terms and rights declaration.
LOFI_REQUIRE_PROVENANCE_FOR_PUBLISH=
